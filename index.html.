<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>TEMPI | Tu comida a tu temperatura</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%23f28c28'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-family='Arial,sans-serif' font-size='38' font-weight='700' fill='%23237a1f'%3ET%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700;0,800;1,800&family=Caveat:wght@700&display=swap">
<style>
:root{--bg:#f5faee;--soft:#e2f1d4;--or:#f28c28;--teal:#237a1f;--on-teal:#fff;--ink:#1f2f1c;--muted:#4f6449;--card:#fff;--line:#cfe5bd;--gd:#0b4a14;color-scheme:light dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root{--bg:#121b10;--soft:#1e2b1a;--teal:#7fd36a;--on-teal:#0b2208;--ink:#eef5e8;--muted:#b4c5aa;--card:#1a2617;--line:#2f4229;--gd:#cdeec0}}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;font:17px/1.65 'Poppins','Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--ink)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#0b4a14;z-index:30}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
.topbar{background:#0b4a14;color:#e8f2de;font-size:.82rem;display:flex;justify-content:space-around;gap:6px 18px;padding:9px 6%;flex-wrap:wrap;text-align:center}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--card);border-bottom:1px solid var(--line);padding:12px 6%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.logo{font:800 italic 32px 'Poppins','Segoe UI',Arial,sans-serif;color:var(--gd);text-decoration:none;display:flex;align-items:center;gap:6px}
.logo svg{width:26px;height:26px}
nav{display:flex;gap:18px;flex-wrap:wrap}
header nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:.92rem;padding:8px 16px;border-radius:20px}
header nav{gap:4px;align-items:center}
header nav a.cartlink{background:var(--teal);color:var(--on-teal)}
header nav a:hover{background:var(--soft)}
.btn{display:inline-block;padding:14px 28px;border-radius:30px;border:2px solid transparent;font:700 1rem 'Poppins','Segoe UI',Arial,sans-serif;cursor:pointer;text-decoration:none;background:var(--or);color:#2a1604}
.btn:hover{filter:brightness(.93)}
.btn.teal{background:var(--teal);color:var(--on-teal)}
.btn.line{background:none;border-color:var(--teal);color:var(--teal)}
.hero{position:relative;background:#fff url('data:image/jpeg;base64,') center top/cover no-repeat;min-height:max(calc(100svh - 130px),52vw);padding:clamp(120px,20.5vw,420px) 6% 60px;display:flex;justify-content:center;align-items:flex-start}
.hero .box{max-width:760px;text-align:center}
.hero h2{font:700 clamp(2.3rem,5.4vw,4rem)/1.08 'Caveat','Segoe Script','Brush Script MT',cursive;color:#237a1f;margin:0 0 14px;text-decoration:underline;text-decoration-color:#f28c28;text-decoration-thickness:3px;text-underline-offset:8px}
.hero p{font-size:1.2rem;color:#27441f;margin:0 auto 26px;max-width:44ch}
.hero .btns{justify-content:center}
.hero .btn.teal{background:#237a1f;color:#fff;box-shadow:0 10px 24px #0b4a1440}
.hero .btn.line{background:#fff;border-color:#237a1f;color:#237a1f}
.chips{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:28px}
.chips span{background:#fff;border:1px solid #cfe5bd;border-radius:30px;padding:8px 18px 8px 9px;font-weight:600;font-size:.9rem;color:#1f2f1c;display:flex;align-items:center;gap:9px;box-shadow:0 6px 16px #0b4a1426}
.chips i{font-style:normal;width:30px;height:30px;border-radius:50%;background:#e2f1d4;color:#237a1f;display:grid;place-items:center}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.btns{display:flex;gap:14px;flex-wrap:wrap}
.perks{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;padding:20px 6%;background:var(--soft)}
.perk{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 18px;font-weight:600;font-size:.92rem;line-height:1.3}
.perk i{font-style:normal;width:38px;height:38px;border-radius:50%;background:var(--soft);display:grid;place-items:center;color:var(--teal);flex:none;font-size:1.1rem}
section{padding:90px 6%}
.title{text-align:center;max-width:680px;margin:0 auto 46px}
.title h2{font-size:clamp(2rem,4.5vw,3rem);margin:0 0 10px;line-height:1.1}
.title p{margin:0;color:var(--muted);font-size:1.1rem}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:30px;max-width:1200px;margin:0 auto}
.card{background:var(--card);border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:0 10px 30px #33210f18;display:flex;flex-direction:column}
.card .pic{background:#fff;aspect-ratio:4/3;display:grid;place-items:center;padding:14px}
.card .pic img{max-width:100%;max-height:100%;object-fit:contain}
.card .body{padding:26px;display:flex;flex-direction:column;gap:8px;flex:1}
.tag{align-self:flex-start;background:var(--soft);padding:3px 12px;border-radius:14px;font-size:.85rem;font-weight:bold}
.card h3{margin:0;font-size:1.6rem}
.card p{margin:0;color:var(--muted)}
.swatches{display:flex;gap:10px;align-items:center;margin-top:6px;flex-wrap:wrap}
.swatches button{width:36px;height:36px;border-radius:50%;border:3px solid var(--card);box-shadow:0 0 0 2px var(--line);cursor:pointer;padding:0}
.swatches button[aria-pressed=true]{box-shadow:0 0 0 3px var(--teal)}
.cname{font-weight:bold;margin-left:4px}
.price{font-size:32px;font-weight:bold;color:var(--or);margin-top:8px}
.small{font-size:13px;color:var(--muted)}
.card .btn{margin-top:auto}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:26px;max-width:1100px;margin:0 auto}
.step{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:30px}
.step .n{width:46px;height:46px;border-radius:50%;background:var(--or);color:#2a1604;display:grid;place-items:center;font-weight:bold;font-size:1.3rem;margin-bottom:14px}
.step h3{margin:0 0 6px}
.step p{margin:0;color:var(--muted)}
.alt{background:var(--soft)}
.tablewrap{max-width:1000px;margin:0 auto;overflow-x:auto;background:var(--card);border-radius:22px;border:1px solid var(--line)}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{padding:16px 20px;text-align:left;border-bottom:1px solid var(--line)}
th{background:var(--teal);color:var(--on-teal)}
tr:last-child td{border-bottom:0}
.eco{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
.eco h2{font-size:clamp(2rem,4vw,2.8rem);margin:0 0 16px;line-height:1.1}
.eco p{color:var(--muted);margin:0 0 14px}
.eco .big{background:var(--teal);color:var(--on-teal);border-radius:30px;padding:44px;font-size:1.5rem;line-height:1.35;font-weight:bold}
.faq{max-width:800px;margin:0 auto}
details{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 22px;margin-bottom:12px}
summary{cursor:pointer;font-weight:bold;font-size:1.05rem}
details p{margin:10px 0 0;color:var(--muted)}
.cart{max-width:720px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:32px}
.line-i{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
.line-i small{display:block;color:var(--muted)}
.qty{display:flex;align-items:center;gap:8px}
.qty button{width:32px;height:32px;border-radius:50%;border:1px solid var(--teal);background:none;color:var(--teal);cursor:pointer;font-weight:bold}
.total{display:flex;justify-content:space-between;font-size:1.4rem;margin:20px 0}
footer{background:#0b3a12;color:#e8f2de;text-align:center;padding:44px 6%}
footer h2{margin:0 0 6px;letter-spacing:4px;color:#cfe3bf}
footer nav{justify-content:center;margin:14px 0}
footer nav a{color:#e8f2de;text-decoration:none;font-weight:600}
footer p{margin:4px 0}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,120px);background:var(--teal);color:var(--on-teal);padding:14px 24px;border-radius:30px;font-weight:bold;transition:transform .3s;z-index:40}
.toast.on{transform:translate(-50%,0)}
@media(max-width:860px){.eco{grid-template-columns:1fr}.hero{min-height:0;padding-top:200px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.toast{transition:none}}
</style>
</head>
<body>

<div class="topbar"><span>Envío gratis en pedidos superiores a 80 €</span><span>Regístrate y consigue cupones de descuento</span><span>Garantía de 3 años</span></div>
<header>
  <a class="logo" href="#inicio"><svg viewBox='0 0 64 64' aria-hidden='true'><path d='M8 56C8 28 26 8 56 6 56 36 40 54 8 56Z' fill='#237a1f'/><path d='M10 54C24 40 36 28 50 12' stroke='#e4ecd6' stroke-width='3' fill='none' stroke-linecap='round'/></svg>TEMPI</a>
  <nav>
    <a href="#inicio">Inicio</a>
    <a href="#modelos">Tienda</a>
    <a href="#como">Cómo funciona</a>
    <a href="#comparar">Comparar</a>
    <a href="#sostenible">Sostenibilidad</a>
    <a href="#preguntas">Ayuda</a>
    <a class="cartlink" href="#carrito">Carrito (<span id="count">0</span>)</a>
  </nav>
</header>

<main>
<div class="hero" id="inicio">
  <h1 class="sr">TEMPI, el tupper inteligente</h1>
  <div class="box">
    <h2>Tu comida, a tu temperatura</h2>
    <p>El tupper inteligente que calienta y enfría tu comida en cualquier lugar.</p>
    <div class="btns">
      <a href="#modelos" class="btn teal">Descubre la colección →</a>
      <a href="#como" class="btn line">Cómo funciona</a>
    </div>
    <div class="chips"><span><i>♨</i>Calienta tu comida</span><span><i>❄</i>Enfría y conserva</span><span><i>♻</i>Diseño sostenible</span></div>
  </div>
</div>

<div class="perks">
  <div class="perk"><i>♨</i>Comida siempre lista</div>
  <div class="perk"><i>⚡</i>Tecnología práctica</div>
  <div class="perk"><i>🎒</i>Ideal para el trabajo, la universidad o viajes</div>
  <div class="perk"><i>♻</i>Diseño sostenible</div>
</div>

<section id="modelos">
  <div class="title">
    <h2>Elige tu TEMPI</h2>
    <p>Tres tamaños. Pulsa un color para ver cómo queda antes de comprarlo.</p>
  </div>
  <div class="products" id="products"></div>
</section>

<section class="alt" id="como">
  <div class="title"><h2>Así de fácil</h2><p>Tres pasos y tu comida lista donde quieras.</p></div>
  <div class="steps">
    <div class="step"><div class="n">1</div><h3>Elige tu modelo</h3><p>Mini, Clásico o Maxi, según cuánta comida quieras llevar.</p></div>
    <div class="step"><div class="n">2</div><h3>Pon tu comida</h3><p>Llénalo, ciérralo con los clips y listo para salir.</p></div>
    <div class="step"><div class="n">3</div><h3>Elige la temperatura</h3><p>Desde la pantalla táctil, y disfruta de tu comida a tu gusto.</p></div>
  </div>
</section>

<section id="comparar">
  <div class="title"><h2>Compara los modelos</h2><p>Todo lo importante de un vistazo.</p></div>
  <div class="tablewrap">
    <table>
      <thead><tr><th>Modelo</th><th>Tamaño</th><th>Colores</th><th>Ideal para</th><th>Precio</th></tr></thead>
      <tbody>
        <tr><td><strong>TEMPI MINI</strong></td><td>Pequeño</td><td>Rosa, lila, azul marino</td><td>Llevarlo a todas partes</td><td>59,90 €</td></tr>
        <tr><td><strong>TEMPI CLÁSICO</strong></td><td>Mediano</td><td>Azul cielo, coral, verde salvia</td><td>El día a día</td><td>79,90 €</td></tr>
        <tr><td><strong>TEMPI MAXI</strong></td><td>Grande</td><td>Grafito, arena</td><td>Más raciones</td><td>99,90 €</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="alt" id="sostenible">
  <div class="eco">
    <div class="big">Pensado para durar, para reciclar y para gastar lo justo.</div>
    <div>
      <h2>Cuidamos el planeta</h2>
      <p>TEMPI utilizará materiales resistentes, reducirá los embalajes innecesarios y facilitará información para el reciclaje del producto. También realizará pruebas para conocer su consumo energético real.</p>
      <p>Además, TEMPI tendrá en cuenta que, al tratarse de un producto que funciona con electricidad, es importante controlar su consumo energético. Por ello, durante el desarrollo del producto se realizarán pruebas para comprobar cuánta energía necesita para calentar y enfriar los alimentos, buscando que sea lo más eficiente posible.</p>
    </div>
  </div>
</section>

<section id="preguntas">
  <div class="title"><h2>Preguntas frecuentes</h2></div>
  <div class="faq">
    <details><summary>¿Puedo elegir el color?</summary><p>Sí. Cada modelo tiene sus colores: pulsa el círculo del color que quieras en la tarjeta del modelo y añádelo al carrito.</p></details>
    <details><summary>¿Qué diferencia hay entre los modelos?</summary><p>El tamaño. El Mini es el más compacto, el Clásico es el más versátil y el Maxi es el de mayor capacidad.</p></details>
    <details><summary>¿Cómo se controla la temperatura?</summary><p>Con la pantalla táctil que lleva delante, que también tiene reloj y botón de encendido.</p></details>
    <details><summary>¿Es sostenible?</summary><p>Ese es uno de nuestros objetivos: materiales resistentes, menos embalaje, información para reciclar y pruebas de consumo energético.</p></details>
    <details><summary>¿Es una tienda real?</summary><p>Es una demostración de un proyecto escolar, así que no se hacen cobros ni envíos.</p></details>
  </div>
</section>

<section class="alt" id="carrito">
  <div class="title"><h2>Mi carrito</h2></div>
  <div class="cart">
    <div id="items">Todavía no has añadido ningún producto.</div>
    <div class="total"><strong>Total:</strong><strong id="total">0,00 €</strong></div>
    <div class="btns"><button class="btn teal" id="buy">Finalizar compra</button><button class="btn line" id="clear">Vaciar carrito</button></div>
    <p class="small">Compra de demostración para un proyecto escolar.</p>
  </div>
</section>
</main>

<footer>
  <h2>TEMPI</h2>
  <p>Tu comida a tu temperatura.</p>
  <nav><a href="#modelos">Modelos</a><a href="#comparar">Comparar</a><a href="#sostenible">Sostenibilidad</a><a href="#preguntas">Preguntas</a></nav>
  <p>© 2026 TEMPI · Proyecto escolar</p>
</footer>
<div class="toast" id="toast" role="status"></div>

<script>
var MODELS=[
 {n:'TEMPI MINI',tag:'Compacto',d:'Compacto y práctico para llevar tu comida.',p:59.90,c:[
  {n:'Rosa',h:'#f2a7b3',i:'data:image/jpeg;base64,'},{n:'Lila',h:'#b9a0e0',i:'data:image/jpeg;base64,'},{n:'Azul marino',h:'#1f3a6b',i:'data:image/jpeg;base64,'}]},
 {n:'TEMPI CLÁSICO',tag:'El más versátil',d:'Una opción versátil para tu día a día.',p:79.90,c:[
  {n:'Azul cielo',h:'#7fb0dd',i:'data:image/jpeg;base64,'},{n:'Coral',h:'#f08a76',i:'data:image/jpeg;base64,'},{n:'Verde salvia',h:'#a9cfa3',i:'data:image/jpeg;base64,'}]},
 {n:'TEMPI MAXI',tag:'Más capacidad',d:'Más capacidad para quienes necesitan más espacio.',p:99.90,c:[
  {n:'Grafito',h:'#4b4f56',i:'data:image/jpeg;base64,'},{n:'Arena',h:'#e3c9ac',i:'data:image/jpeg;base64,'}]}
];
var sel=[0,0,0],cart=[];
function eur(x){return x.toFixed(2).replace('.',',')+' €'}
function drawProducts(){
 var box=document.getElementById('products');box.innerHTML='';
 MODELS.forEach(function(m,k){
  var c=m.c[sel[k]],card=document.createElement('div');card.className='card';
  var sw=m.c.map(function(x,j){return '<button type="button" data-m="'+k+'" data-c="'+j+'" style="background:'+x.h+'" aria-label="'+x.n+'" aria-pressed="'+(j===sel[k])+'"></button>'}).join('');
  card.innerHTML='<div class="pic"><img src="'+c.i+'" alt="'+m.n+' en '+c.n+'"></div><div class="body"><span class="tag">'+m.tag+'</span><h3>'+m.n+'</h3><p>'+m.d+'</p><div class="swatches">'+sw+'<span class="cname">'+c.n+'</span></div><div class="price">'+eur(m.p)+'</div><p class="small">IVA incluido</p><button class="btn" data-add="'+k+'">Añadir al carrito</button></div>';
  box.appendChild(card);
 });
}
function toast(t){var e=document.getElementById('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(function(){e.classList.remove('on')},1800)}
function drawCart(){
 var it=document.getElementById('items'),sum=0,n=0;it.innerHTML='';
 cart.forEach(function(l,idx){
  sum+=l.p*l.q;n+=l.q;
  var d=document.createElement('div');d.className='line-i';
  var a=document.createElement('div'),s=document.createElement('strong'),sm=document.createElement('small');
  s.textContent=l.n;sm.textContent='Color: '+l.c+' · '+eur(l.p);a.append(s,sm);
  var q=document.createElement('div');q.className='qty';
  var mi=document.createElement('button'),pl=document.createElement('button'),qq=document.createElement('span');
  mi.textContent='−';pl.textContent='+';qq.textContent=l.q;mi.setAttribute('aria-label','Quitar uno');pl.setAttribute('aria-label','Añadir uno');
  mi.onclick=function(){l.q--;if(l.q<1)cart.splice(idx,1);drawCart()};
  pl.onclick=function(){l.q++;drawCart()};
  q.append(mi,qq,pl);
  var pr=document.createElement('strong');pr.textContent=eur(l.p*l.q);
  d.append(a,q,pr);it.appendChild(d);
 });
 if(!cart.length)it.textContent='Todavía no has añadido ningún producto.';
 document.getElementById('total').textContent=eur(sum);
 document.getElementById('count').textContent=n;
}
document.addEventListener('click',function(e){
 var b=e.target.closest('button');if(!b)return;
 if(b.dataset.c!==undefined){sel[b.dataset.m]=+b.dataset.c;drawProducts();return}
 if(b.dataset.add!==undefined){
  var m=MODELS[b.dataset.add],c=m.c[sel[b.dataset.add]],f=cart.find(function(l){return l.n===m.n&&l.c===c.n});
  if(f)f.q++;else cart.push({n:m.n,c:c.n,p:m.p,q:1});
  drawCart();toast(m.n+' ('+c.n+') añadido al carrito');
 }
});
document.getElementById('clear').onclick=function(){cart=[];drawCart()};
document.getElementById('buy').onclick=function(){
 if(!cart.length){toast('Tu carrito está vacío');return}
 alert('¡Gracias por elegir TEMPI! Esta es una demostración de compra para el proyecto escolar.');
};
drawProducts();drawCart();
</script>
</body>
</html>
